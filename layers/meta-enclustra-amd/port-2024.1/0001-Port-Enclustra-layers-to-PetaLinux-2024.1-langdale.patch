Subject: [PATCH 1/3] Port Enclustra layers to PetaLinux 2024.1 (langdale)

---
 meta-enclustra-baseboard/conf/layer.conf | 2 +-
 meta-enclustra-module/conf/layer.conf    | 2 +-
 meta-enclustra-refdes/conf/layer.conf    | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/meta-enclustra-baseboard/conf/layer.conf b/meta-enclustra-baseboard/conf/layer.conf
index 6c875d9..4ad2c61 100644
--- a/meta-enclustra-baseboard/conf/layer.conf
+++ b/meta-enclustra-baseboard/conf/layer.conf
@@ -9,4 +9,4 @@ BBFILE_COLLECTIONS += "enclustra-baseboard"
 BBFILE_PATTERN_enclustra-baseboard = "^${LAYERDIR}/"
 BBFILE_PRIORITY_enclustra-baseboard = "20"
 LAYERVERSION = "1"
-LAYERSERIES_COMPAT_enclustra-baseboard = "scarthgap"
+LAYERSERIES_COMPAT_enclustra-baseboard = "langdale scarthgap"
diff --git a/meta-enclustra-module/conf/layer.conf b/meta-enclustra-module/conf/layer.conf
index 4b093c6..0786fd7 100644
--- a/meta-enclustra-module/conf/layer.conf
+++ b/meta-enclustra-module/conf/layer.conf
@@ -18,5 +18,5 @@ BBFILE_PRIORITY_enclustra-module = "10"
 BBFILE_PATTERN_IGNORE_EMPTY_enclustra-module = "1"
 
 LAYERVERSION = "1"
-LAYERSERIES_COMPAT_enclustra-module = "scarthgap"
+LAYERSERIES_COMPAT_enclustra-module = "langdale scarthgap"
 LAYERDEPENDS_enclustra-module = "xilinx"
diff --git a/meta-enclustra-refdes/conf/layer.conf b/meta-enclustra-refdes/conf/layer.conf
index ad53afb..b6c9c9f 100644
--- a/meta-enclustra-refdes/conf/layer.conf
+++ b/meta-enclustra-refdes/conf/layer.conf
@@ -9,4 +9,4 @@ BBFILE_COLLECTIONS += "enclustra-refdes"
 BBFILE_PATTERN_enclustra-refdes = "^${LAYERDIR}/"
 BBFILE_PRIORITY_enclustra-refdes = "20"
 LAYERVERSION = "1"
-LAYERSERIES_COMPAT_enclustra-refdes = "scarthgap"
+LAYERSERIES_COMPAT_enclustra-refdes = "langdale scarthgap"
-- 
2.34.1

